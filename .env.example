# --- Supabase (required to run the app) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — SERVER ONLY. Used by ingestion jobs and admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI ---
# "anthropic" (default when ANTHROPIC_API_KEY is set) or "mock" (deterministic, no key needed)
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MODEL_FAST=claude-haiku-4-5-20251001

# --- Scheduled jobs (Phase 2) ---
CRON_SECRET=
